<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tab_dns"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/dns_filter_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">
        <TextView android:id="@+id/chip_all" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp" android:text="@string/filter_all" android:textSize="12.5sp" />
        <TextView android:id="@+id/chip_blocked" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp" android:text="@string/filter_blocked" android:textSize="12.5sp" />
        <TextView android:id="@+id/chip_allowed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp" android:text="@string/filter_allowed" android:textSize="12.5sp" />
        <TextView android:id="@+id/chip_bypass" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp" android:text="@string/filter_bypass" android:textSize="12.5sp" />
        <TextView android:id="@+id/chip_cache" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp" android:text="@string/filter_cache" android:textSize="12.5sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/dns_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_hint"
        android:textColor="@color/text"
        android:textColorHint="@color/faint"
        android:singleLine="true"
        android:paddingBottom="8dp" />

    <ListView
        android:id="@+id/dns_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/border"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/dns_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/empty_log"
        android:textColor="@color/faint"
        android:visibility="gone" />
</LinearLayout>
