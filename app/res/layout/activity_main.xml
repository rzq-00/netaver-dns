<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingTop="6dp">

        <Button android:id="@+id/nav_home" style="@style/NavButton" android:text="@string/tab_home" />
        <Button android:id="@+id/nav_dns" style="@style/NavButton" android:text="@string/tab_dns" />
        <Button android:id="@+id/nav_apps" style="@style/NavButton" android:text="@string/tab_apps" />
        <Button android:id="@+id/nav_lists" style="@style/NavButton" android:text="@string/tab_lists" />
        <Button android:id="@+id/nav_settings" style="@style/NavButton" android:text="@string/tab_settings" />
    </LinearLayout>
</LinearLayout>
