<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="34dp"
                android:src="@drawable/logo_netaver"
                android:contentDescription="NetAver DNS logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/protected_off"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/power_button"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/power_bg"
                android:src="@drawable/ic_power"
                android:scaleType="centerInside"
                android:padding="30dp"
                android:contentDescription="power" />

            <TextView
                android:id="@+id/latency_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/green"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/check_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/power_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/tap_to_start"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/uptime_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/card_queries" style="@style/Card" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_queries" android:textColor="@color/muted" android:textSize="11sp" />
                    <TextView android:id="@+id/stat_queries" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/card_blocked" style="@style/Card" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_blocked" android:textColor="@color/muted" android:textSize="11sp" />
                    <TextView android:id="@+id/stat_blocked" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/red" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <LinearLayout style="@style/Card" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_rate" android:textColor="@color/muted" android:textSize="11sp" />
                    <TextView android:id="@+id/stat_rate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="@color/accent" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout style="@style/Card" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_upstream" android:textColor="@color/muted" android:textSize="11sp" />
                    <TextView android:id="@+id/stat_upstream" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.1.1.1" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/stat_latency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/green" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stats_period" android:textColor="@color/faint" android:textSize="11sp" android:gravity="center" android:paddingTop="8dp" />
        <LinearLayout
            android:id="@+id/home_upstream_row"
            style="@style/Card"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_upstream" android:textColor="@color/muted" android:textSize="11sp" />
                <TextView android:id="@+id/home_upstream_names" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/accent" android:textSize="22sp" android:layout_gravity="center_vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NetAver"
                android:textColor="#cbd5e1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Your Network, Your Rules"
                android:textColor="#64748b"
                android:textSize="12sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/home_version_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
