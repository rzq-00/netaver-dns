<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/detail_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back_apps"
            android:textColor="@color/accent"
            android:background="@android:color/transparent"
            android:paddingStart="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/detail_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/badge_bg"
                android:gravity="center"
                android:textColor="@color/accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/detail_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/detail_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="14sp"
                android:paddingEnd="8dp" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/internet_access"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detail_fw_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/detail_fw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dns_queries_label"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp" />

        <RadioGroup
            android:id="@+id/detail_filter_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <RadioButton android:id="@+id/detail_f_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_all" android:textColor="@color/text" android:textSize="12sp" android:checked="true" />
            <RadioButton android:id="@+id/detail_f_blocked" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_blocked" android:textColor="@color/text" android:textSize="12sp" />
            <RadioButton android:id="@+id/detail_f_allowed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_allowed" android:textColor="@color/text" android:textSize="12sp" />
            <RadioButton android:id="@+id/detail_f_bypass" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_bypass" android:textColor="@color/text" android:textSize="12sp" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/detail_dns_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/detail_conn_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connections_label"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:id="@+id/detail_conn_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/detail_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/empty_app_log"
            android:textColor="@color/faint"
            android:paddingTop="24dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
