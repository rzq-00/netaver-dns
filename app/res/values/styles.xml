<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NavButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <!-- Kill the Material Button minimum width (88dp) and background insets:
             six of them exceed a 360dp screen, so the weighted slots could not
             shrink evenly and the labels ended up irregularly spaced. With
             these zeroed, all six tabs get exactly the same width. -->
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">12dp</item>
    </style>
    
</resources>
